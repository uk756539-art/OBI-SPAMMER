local chatHistory = {{role = "system", content = SYSTEM_PROMPT}}
local MAX_HISTORY = 20

local function addToHistory(role, content)
    table.insert(chatHistory, {role = role, content = content})
    while #chatHistory > MAX_HISTORY + 1 do
        table.remove(chatHistory, 2)
    end
end

