local function getGeneralChannel()
	local ok, channel = pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			return TextChatService.TextChannels:FindFirstChild("RBXGeneral")
		end
		return nil
	end)
	if ok then return channel end
	return nil
end

local function getSayMessageEvent()
	local dcs = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
	return dcs and dcs:FindFirstChild("SayMessageRequest")
end

local function sendChatMessage(msg)
	pcall(function()
		local gc = getGeneralChannel()
		if gc then
			gc:SendAsync(msg)
		else
			local sayEvt = getSayMessageEvent()
			if sayEvt then
				sayEvt:FireServer(msg, "All")
			end
		end
	end)
end

