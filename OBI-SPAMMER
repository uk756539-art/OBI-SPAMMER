local function getFallback(message)
    local msg = string.lower(message)
    for _, group in ipairs(fallbackKeywords) do
        for _, key in ipairs(group.keys) do
            if string.find(msg, key, 1, true) then
                return group.replies[math.random(1, #group.replies)]
            end
        end
    end
    local defaults = {
        "Hmm, samjhi nahi! 😅 Kuch aur bolo na 💕",
        "Achha! Aur batao yaar 😊",
        "Waah! Kya baat hai ✨",
        "Hmm hmm, batao aur 💕"
    }
    return defaults[math.random(1, #defaults)]
end

-- ============================================
-- 🌐 AI CALL
-- ============================================
local function getAIResponse(message)
    if API_KEY == "gsk_YAHAN_APNI_GROQ_KEY_PASTE_KARO" then
        return getFallback(message)
    end
    
    addToHistory("user", message)
    
    local payload = HttpService:JSONEncode({
        model = AI_MODEL,
        messages = chatHistory,
        temperature = 0.85,
        max_tokens = 150,
        top_p = 0.9,
    })
    
    local success, response = pcall(function()
        return HttpService:PostAsync(
            API_URL,
            payload,
            Enum.HttpContentType.ApplicationJson,
            false,
            {
                ["Authorization"] = "Bearer " .. API_KEY,
                ["Content-Type"] = "application/json",
            }
        )
    end)
    
    if success then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        
        if ok and data and data.choices and data.choices[1] then
            local reply = data.choices[1].message.content
            addToHistory("assistant", reply)
            return reply
        end
        return getFallback(message)
    else
        local err = tostring(response)
        warn("❌ API Error: " .. err)
        
        if string.find(err, "401") then
            return "Oii, key problem! 😅 Nai key daalo 💕"
        elseif string.find(err, "429") then
            return "Thoda ruko yaar! 😊 1 min baad 💕"
        else
            return getFallback(message)
        end
    end
end

