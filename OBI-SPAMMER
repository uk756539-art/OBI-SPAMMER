local function addMessage(text, isPlayer)
    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(0, 280, 0, 0)
    msgFrame.AutomaticSize = Enum.AutomaticSize.Y
    msgFrame.BackgroundColor3 = isPlayer and Color3.fromRGB(80, 150, 255) or Color3.fromRGB(60, 50, 75)
    msgFrame.BorderSizePixel = 0
    msgFrame.Parent = scrollFrame
    
    if isPlayer then
        msgFrame.AnchorPoint = Vector2.new(1, 0)
        msgFrame.Position = UDim2.new(1, 0, 0, 0)
    end
    
    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 12)
    mCorner.Parent = msgFrame
    
    if not isPlayer then
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 105, 180)
        stroke.Thickness = 2
        stroke.Transparency = 0.3
        stroke.Parent = msgFrame
    end
    
    local mPadding = Instance.new("UIPadding")
    mPadding.PaddingTop = UDim.new(0, 10)
    mPadding.PaddingBottom = UDim.new(0, 10)
    mPadding.PaddingLeft = UDim.new(0, 14)
    mPadding.PaddingRight = UDim.new(0, 14)
    mPadding.Parent = msgFrame
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, 0, 0, 0)
    msgLabel.AutomaticSize = Enum.AutomaticSize.Y
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = text
    msgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    msgLabel.TextSize = 15
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextWrapped = true
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextYAlignment = Enum.TextYAlignment.Top
    msgLabel.Parent = msgFrame
    
    task.wait()
    scrollFrame.CanvasPosition = Vector2.new(0, scrollFrame.AbsoluteCanvasSize.Y)
end

